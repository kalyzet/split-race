[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/results.gd" id="1_results"]

[node name="Results" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_results")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Menu" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Center/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 46
text = "RACE RESULTS"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="Spacer2" type="Control" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[node name="BestLapLabel" type="Label" parent="Center/Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "BEST LAP  --:--.--"
horizontal_alignment = 1

[node name="Spacer3" type="Control" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Center/Menu"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 18

[node name="AgainButton" type="Button" parent="Center/Menu/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Play Again"

[node name="HomeButton" type="Button" parent="Center/Menu/Buttons"]
custom_minimum_size = Vector2(240, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Home"

[connection signal="pressed" from="Center/Menu/Buttons/AgainButton" to="." method="_on_again_button_pressed"]
[connection signal="pressed" from="Center/Menu/Buttons/HomeButton" to="." method="_on_home_pressed"]
